    {"week":36,"href":"Занятие 36/Занятие-36-Итоговое-занятие.html","title":"Итоговое занятие","module":"Модуль 4","type":"Итог","why":"Получаем сертификаты и ставим цели на следующий уровень"}
  ];

  const PFKEY = "pdn-course-users";
  const CUKEY = "pdn-course-active";
  const PROGKEY = "pdn-course-progress-";
  const TEACHER_KEY = "pd_teacher_mode";
  function isTeacherMode() { try { return localStorage.getItem(TEACHER_KEY) === "1"; } catch (e) { return false; } }
  function setTeacherMode(v) { try { localStorage.setItem(TEACHER_KEY, v ? "1" : ""); } catch (e) {} }
  function updateTeacherToolbar() {
    const tb = document.getElementById("teacherToolbar");
    const th = document.getElementById("teachHint");
    const on = isTeacherMode();
    if (tb) tb.style.display = on ? "flex" : "none";
    if (th) th.style.display = on ? "block" : "none";
  }
  // Секретный вход в режим педагога: 5 кликов по заголовку
  (function () {
    var clicks = 0, timer = null;
    var h1 = document.querySelector("header h1");
    if (h1) h1.style.cursor = "pointer";
    document.addEventListener("click", function (e) {
      if (e.target === h1 || (h1 && h1.contains(e.target))) {
        clicks++;
        if (timer) clearTimeout(timer);
        timer = setTimeout(function () { clicks = 0; }, 1500);
        if (clicks >= 5) {
          clicks = 0;
          setTeacherMode(!isTeacherMode());
          updateTeacherToolbar();
          alert(isTeacherMode() ? "Режим педагога включён." : "Режим педагога выключен.");
        }
      }
    });
  })();

  function getProfiles() { try { return JSON.parse(localStorage.getItem(PFKEY) || "[]"); } catch (e) { return []; } }
  function saveProfiles(a) { try { localStorage.setItem(PFKEY, JSON.stringify(a)); } catch (e) {} }
  function currentUid() { try { return localStorage.getItem(CUKEY); } catch (e) { return null; } }
  function me() {
    const id = currentUid();
    if (!id) return null;
    try {
      const arr = getProfiles();
      return arr.find((p) => String(p.uid) === String(id)) || null;
    } catch (e) { return null; }
  }
  function getProgress(uid) {
    let a = [];
    try { a = JSON.parse(localStorage.getItem(PROGKEY + uid) || "[]"); } catch (e) { a = []; }
    if (!Array.isArray(a)) a = [];
    while (a.length < 36) a.push(false);
    return a;
  }
  function setProgress(uid, lesson, done) {
    const a = getProgress(uid);
    a[lesson - 1] = !!done;
    try { localStorage.setItem(PROGKEY + uid, JSON.stringify(a)); } catch (e) {}
  }

  function renderAuth() {
    const panel = document.getElementById("authPanel");
    const bar = document.getElementById("userBar");
    const list = document.getElementById("profilesList");
    const ig = document.getElementById("infographic");
    const u = me();
    if (u) {
      panel.style.display = "none";
      bar.style.display = "flex";
      if (ig) ig.classList.add("revealed");
      const ig2 = document.getElementById("infographicLayers");
      if (ig2) ig2.classList.add("revealed");
      document.getElementById("ubName").textContent = u.name;
      document.getElementById("ubKlass").textContent = u.klass ? (u.klass + " класс" + (u.group ? " · " + u.group : "")) : "";
      render();
      return;
    }
    panel.style.display = "block";
    bar.style.display = "none";
    if (ig) ig.classList.remove("revealed");
    const ig2 = document.getElementById("infographicLayers");
    if (ig2) ig2.classList.remove("revealed");
    list.innerHTML = "";
    getProfiles().forEach((p) => {
      const b = document.createElement("button");
      b.textContent = p.name + (p.klass ? " (" + p.klass + ")" : "");
      b.onclick = () => { try { localStorage.setItem(CUKEY, p.uid); } catch (e) {} renderAuth(); };
      list.appendChild(b);
    });
  }

  function doLogin() {
    const name = document.getElementById("inpName").value.trim();
    const klass = document.getElementById("inpKlass").value.trim();
    const group = document.getElementById("inpGroup").value.trim();
    if (!name) { document.getElementById("authMsg").textContent = "Введи фамилию и имя."; return; }
    const parts = name.split(/\s+/);
    const first = parts.slice(1).join(" ") || "";
    const last = parts[0] || name;
    const profs = getProfiles();
    let found = profs.find((p) => (p.name || "").toLowerCase() === name.toLowerCase() && (p.klass || "") === klass);
    if (!found) {
      found = { uid: "u" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7), name, first, last, klass, group };
      profs.push(found);
      saveProfiles(profs);
    }
    try { localStorage.setItem(CUKEY, found.uid); } catch (e) {}
    document.getElementById("inpName").value = "";
    document.getElementById("inpKlass").value = "";
    document.getElementById("inpGroup").value = "";
    document.getElementById("authMsg").textContent = "";
    renderAuth();
  }

  function doLogout() { try { localStorage.removeItem(CUKEY); } catch (e) {} renderAuth(); }

  function render() {
    const u = me();
    const grid = document.getElementById("grid");
    grid.innerHTML = "";
    if (!u) {
      document.getElementById("fill").style.width = "0%";
      document.getElementById("progressText").textContent = "Войди, чтобы увидеть свой прогресс";
      lessons.forEach((l) => {
        const w = String(l.week).padStart(2, "0");
        const card = document.createElement("div");
        card.className = "lesson-card card-locked";
        card.innerHTML = '<span class="lw">Занятие ' + w + '</span>' +
          '<span class="module">' + l.module + '</span><h3>' + l.title + '</h3>' +
          '<span class="type">' + l.type + '</span>' +
          '<div class="why">' + l.why + '</div>';
        const st = document.createElement("span");
        st.className = "status locked"; st.textContent = "ждать входа";
        card.appendChild(st);
        grid.appendChild(card);
      });
      return;
    }
    let doneCount = 0;
    lessons.forEach((l, i) => {
      const w = String(l.week).padStart(2, "0");
      const thisDone = !!getProgress(u.uid)[l.week - 1];
      if (thisDone) doneCount++;
      const available = i === 0 || !!getProgress(u.uid)[lessons[i - 1].week - 1];
      const card = document.createElement("div");
      card.className = "lesson-card" + (thisDone ? " card-open" : "") + (available ? "" : " card-locked");
      let statusHtml;
      if (thisDone) statusHtml = "✓ пройдено";
      else if (available) statusHtml = "доступно";
      else statusHtml = "закрыто";
      const linkInner = '<span class="lw">Занятие ' + w + '</span>' +
        '<span class="module">' + l.module + '</span><h3>' + l.title + '</h3>' +
        '<span class="type">' + l.type + '</span>' +
        '<div class="why">' + l.why + '</div>';
      if (available) {
        const a = document.createElement("a");
        const q = "?uid=" + encodeURIComponent(u.uid) +
          "&first=" + encodeURIComponent(u.first || "") +
          "&last=" + encodeURIComponent(u.last || "") +
          "&cls=" + encodeURIComponent(u.klass || "") +
          "&school=" + encodeURIComponent(u.group || "");
        a.href = l.href + q;
        a.innerHTML = linkInner;
        card.appendChild(a);
      } else {
        card.insertAdjacentHTML("beforeend", linkInner + '<div style="color:var(--muted);font-size:.85rem;margin-top:.1rem">Пройди предыдущее занятие, чтобы открыть это</div>');
      }
      const st = document.createElement("span");
      st.className = "status " + (thisDone ? "done" : (available ? "open" : "locked"));
      st.textContent = statusHtml;
      card.appendChild(st);
      grid.appendChild(card);
    });
    const total = lessons.length;
    document.getElementById("fill").style.width = Math.round(doneCount / total * 100) + "%";
    document.getElementById("progressText").textContent = (u.name || "Ученик") + ": пройдено " + doneCount + " из " + total + " занятий";
  }

  function resetProgress() {
    if (!confirm("Сбросить прогресс текущего ученика в этом браузере?")) return;
    const u = me();
    if (u) {
      lessons.forEach((l) => {
        try { localStorage.removeItem(PROGKEY + u.uid); } catch (e) {}
      });
    }
    render();
  }

  function openAll() {
    const u = me();
    if (!u) { document.getElementById("authMsg").textContent = "Сначала войди в профиль."; return; }
    lessons.forEach((l) => setProgress(u.uid, l.week, true));
    render();
  }

  // Обработка возврата из занятия (?uid=...&lesson=...&done=1)
  (function handleReturn() {
    try {
      const sp = new URLSearchParams(window.location.search);
      const uid = sp.get("uid");
      const lesson = parseInt(sp.get("lesson"), 10);
      const done = sp.get("done") === "1";
      if (uid && lesson && done) {
        setProgress(uid, lesson, true);
        try { localStorage.setItem(CUKEY, uid); } catch (e) {}
        history.replaceState(null, "", window.location.pathname);
      } else if (uid) {
        try { localStorage.setItem(CUKEY, uid); } catch (e) {}
        history.replaceState(null, "", window.location.pathname);
      }
    } catch (e) {}
    renderAuth();
    updateTeacherToolbar();
  })();

  // Скрываем технический футер (для педагога), когда ученик открыл занятие из своего профиля
  try {
    if (window.location.search.indexOf("uid") !== -1) {
      var _pdF = document.querySelector("footer");
      if (_pdF) _pdF.style.display = "none";
    }
  } catch (e) {}
</script>
